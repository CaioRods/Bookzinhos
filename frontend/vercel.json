{
  "name": "mybooks-frontend",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/share/book/:id/:slug*",
      "destination": "https://bookzinhos-server.vercel.app/share/book/:id/:slug*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://bookzinhos-server.vercel.app/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
