# Porta do servidor
PORT=3001
NODE_ENV=development

# --- SESSÃO E NAVEGADOR ---
# Origens exatas, separadas por vírgula. Nunca use * com cookies.
FRONTEND_ORIGINS=http://localhost:5173
# Em produção com frontend/API em domínios diferentes: true + none.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_TTL_DAYS=30
# Use somente para criar a primeira conta Admin; remova após o primeiro boot.
# ADMIN_INITIAL_PASSWORD=troque-por-uma-senha-forte
# Hosts adicionais de API/storage, separados por vírgula.
# CSP_CONNECT_SOURCES=https://storage.example.com
# CSP_IMAGE_SOURCES=https://cdn.example.com

# --- BANCO DE DADOS ---
# SQLite Local (padrão se TURSO_DATABASE_URL não for definido)
DATA_DIR=./data

# Turso (SQLite Remoto na Nuvem - Grátis e Persistente)
# TURSO_DATABASE_URL=libsql://sua-url-aqui.turso.io
# TURSO_AUTH_TOKEN=seu-token-aqui

# --- ARMAZENAMENTO DE LIVROS (10 GB+ Grátis) ---
# S3-Compatível: Cloudflare R2 ou Backblaze B2
# S3_ACCESS_KEY_ID=seu-access-key-id
# S3_SECRET_ACCESS_KEY=seu-secret-access-key
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com ou https://s3.us-west-004.backblazeb2.com
# S3_BUCKET_NAME=bookzinhos
# S3_PUBLIC_URL_PREFIX=https://pub-seu-id.r2.dev ou prefixo amigável do B2
# S3_REGION=auto

# --- ALTERNATIVA (1 GB Grátis) ---
# SUPABASE_URL=https://sua-url.supabase.co
# SUPABASE_KEY=sua-key-anonima
# SUPABASE_SERVICE_KEY=sua-key-service-role

# --- LOGIN COM GOOGLE ---
# 1) Acesse https://console.cloud.google.com/apis/credentials
# 2) "Criar credenciais" > "ID do cliente OAuth" > tipo "Aplicativo da Web"
# 3) Em "Origens JavaScript autorizadas", adicione onde o app roda, por exemplo:
#      http://localhost:5173   (desenvolvimento)
#      https://seu-dominio.com (produção)
# 4) Copie o "ID do cliente" (termina em .apps.googleusercontent.com) para cá.
#    O botão do Google aparece sozinho quando esta variável existir.
# GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com

# --- ENVIO DE E-MAIL (código de verificação e recuperação) ---
# Sem uma chave aqui, o app funciona em "modo teste": o código aparece na
# própria tela em vez de ir para o e-mail. Para enviar de verdade, crie uma
# conta grátis na Resend (https://resend.com), gere uma API key e configure:
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# MAIL_FROM=myBooks <onboarding@resend.dev>
